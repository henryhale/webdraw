{
  "name": "webdraw",
  "version": "1.0.0",
  "description": "Excalidraw-compatible drawing editor as a framework-agnostic Lit web component",
  "main": "./dist/webdraw.js",
  "module": "./dist/webdraw.js",
  "types": "./dist/webdraw.d.ts",
  "exports": {
    ".": {
      "types": "./dist/webdraw.d.ts",
      "import": "./dist/webdraw.js"
    },
    "./style.css": "./dist/webdraw.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build"
  },
  "keywords": [
    "excalidraw",
    "lit",
    "web-component",
    "whiteboard"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@excalidraw/common": "0.18.0-4e758db",
    "@excalidraw/element": "0.18.0-4e758db",
    "@excalidraw/math": "0.18.0-4e758db",
    "lit": "^3.3.3",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "roughjs": "4.6.4"
  },
  "devDependencies": {
    "sass": "1.51.0",
    "typescript": "5.9.3",
    "vite": "5.0.12"
  }
}
