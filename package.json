{
  "name": "wdraw",
  "version": "0.1.0",
  "description": "Like excalidraw drawing editor but as a framework-agnostic Lit web component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henryhale/webdraw.git"
  },
  "main": "./dist/webdraw.js",
  "module": "./dist/webdraw.js",
  "types": "./dist/webdraw.d.ts",
  "exports": {
    ".": {
      "types": "./dist/webdraw.d.ts",
      "import": "./dist/webdraw.js"
    },
    "./style.css": "./dist/webdraw.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint src vite.config.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release": "release-it"
  },
  "keywords": [
    "wdraw",
    "web-draw",
    "webdraw",
    "lit",
    "web-component",
    "whiteboard"
  ],
  "author": {
    "name": "Henry Hale",
    "url": "https://github.com/henryhale"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@excalidraw/common": "0.18.0-4e758db",
    "@excalidraw/element": "0.18.0-4e758db",
    "@excalidraw/math": "0.18.0-4e758db",
    "lit": "^3.3.3",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "roughjs": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "eslint": "10.10.0",
    "prettier": "3.8.5",
    "release-it": "^21.0.3",
    "sass": "1.51.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "5.0.12",
    "vitepress": "^1.6.4"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "pnpm lint",
        "pnpm build"
      ]
    },
    "git": {
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publishPackageManager": "pnpm",
      "skipChecks": true,
      "publishArgs": [
        "--no-git-checks"
      ]
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
